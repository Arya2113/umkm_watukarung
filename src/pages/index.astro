---
/**
 * index.astro — Dashboard Utama JELAJAH Watukarung
 * Sesuai Mockup 2: Banner hero, Overview KPI, Peta & Info, Search & Category Filters, Listing horizontal, serta Modal Detail.
 */
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import HeroBanner from "../components/HeroBanner.astro";
import KpiCard from "../components/KpiCard.astro";
import MapPreview from "../components/MapPreview.astro";
import InfoPanel from "../components/InfoPanel.astro";
import ListingCard from "../components/ListingCard.astro";
import UmkmAnalytics from "../components/UmkmAnalytics.astro";
import TopUmkmTable from "../components/TopUmkmTable.astro";

// Import 5 file data JSON
import destinasi from "../data/destinasi.json";
import akomodasi from "../data/akomodasi.json";
import kuliner from "../data/kuliner.json";
import jasa from "../data/jasa.json";
import penunjang from "../data/penunjang.json";

// Siapkan gabungan data listing
const allListings = [
  ...destinasi.map((item, i) => ({
    id: `destinasi-${i}`,
    nama: item.nama,
    kategori: item.kategori || "Destinasi Wisata",
    categoryCode: "destinasi",
    alamat: item.alamat,
    kontak: item.kontak,
    linkGmaps: item.linkGmaps,
    linkFoto: item.linkFoto,
    rating: (4.7 + (i % 3) * 0.1).toFixed(1),
    reviewCount: `${100 + i * 15}`,
    rawItem: item,
  })),
  ...akomodasi.map((item, i) => ({
    id: `akomodasi-${i}`,
    nama: item.nama,
    kategori: item.kategori || "Akomodasi",
    categoryCode: "akomodasi",
    alamat: item.alamat,
    kontak: item.kontak,
    linkGmaps: item.linkGmaps,
    linkFoto: (item as any).linkFoto,
    rating: (4.6 + (i % 4) * 0.1).toFixed(1),
    reviewCount: `${50 + i * 12}`,
    rawItem: item,
  })),
  ...kuliner.map((item, i) => ({
    id: `kuliner-${i}`,
    nama: item.nama,
    kategori: item.kategori || "Kuliner & UMKM",
    categoryCode: "kuliner",
    alamat: item.alamat,
    kontak: item.kontak,
    linkGmaps: item.linkGmaps,
    linkFoto: (item as any).linkFoto,
    rating: (4.7 + (i % 3) * 0.1).toFixed(1),
    reviewCount: `${30 + i * 8}`,
    rawItem: item,
  })),
  ...jasa.map((item, i) => ({
    id: `jasa-${i}`,
    nama: item.nama,
    kategori:
      (item as any).kategori || (item as any).jenisLayanan || "Jasa Wisata",
    categoryCode: "jasa",
    alamat: item.alamat,
    kontak: item.kontak,
    linkGmaps: item.linkGmaps,
    linkFoto: (item as any).linkFoto,
    rating: "4.9",
    reviewCount: `${40 + i * 10}`,
    rawItem: item,
  })),
  ...penunjang.map((item, i) => ({
    id: `penunjang-${i}`,
    nama: item.nama,
    kategori:
      (item as any).kategori || (item as any).jenis || "Fasilitas Penunjang",
    categoryCode: "penunjang",
    alamat: item.alamat,
    kontak: item.kontak,
    linkGmaps: item.linkGmaps,
    linkFoto: (item as any).linkFoto,
    rating: "4.8",
    reviewCount: `${20 + i * 5}`,
    rawItem: item,
  })),
];
---

<Layout title="Dashboard">
  <Navbar />

  <!-- Hero Banner -->
  <HeroBanner />

  <main class="container">
    <!-- Overview Section -->
    <section class="section-overview">
      <div class="overview-header fade-in">
        <h2 class="overview-title">Overview</h2>
        <p class="overview-subtitle">
          Welcome back to the Watukarung tourism dashboard.
        </p>
      </div>

      <!-- 4 KPI Cards Grid (Matching Mockup) -->
      <div class="kpi-grid">
        <KpiCard icon="users" label="Total Visitors" value="12,450" />
        <KpiCard icon="map-pin" label="Popular Spots" value="8" />
        <KpiCard icon="star" label="Total Reviews" value="3,205" />
        <KpiCard icon="bed" label="Active Lodgings" value="42" />
      </div>
    </section>

    <!-- UMKM Analytics Section -->
    <UmkmAnalytics />

    <!-- Map & Info Side-by-Side Grid -->
    <section class="section-map-info">
      <div class="map-info-grid">
        <MapPreview />
        <InfoPanel />
      </div>
    </section>

    <!-- Top 10 UMKM Section -->
    <TopUmkmTable />

    <!-- Search & Category Filters Section -->
    <section class="search-filter-section">
      <!-- Search Input Bar -->
      <div class="search-bar-wrapper fade-in">
        <i data-lucide="search" class="search-bar-icon"></i>
        <input
          type="text"
          id="search-input"
          class="search-bar-input"
          placeholder="Cari destinasi, penginapan, kuliner..."
          autocomplete="off"
        />
      </div>

      <!-- Category Filter Pills -->
      <div class="category-pills fade-in" id="category-pills">
        <button class="category-pill active" data-category="all"
          >All Destinasi Wisata</button
        >
        <button class="category-pill" data-category="destinasi"
          >Destinasi Wisata</button
        >
        <button class="category-pill" data-category="akomodasi"
          >Akomodasi</button
        >
        <button class="category-pill" data-category="kuliner"
          >Kuliner & UMKM</button
        >
        <button class="category-pill" data-category="jasa">Jasa Wisata</button>
        <button class="category-pill" data-category="penunjang"
          >Penunjang</button
        >
      </div>
    </section>

    <!-- Listings Grid/List -->
    <div class="listing-list" id="listing-list">
      {
        allListings.map((item) => (
          <ListingCard
            id={item.id}
            nama={item.nama}
            kategori={item.kategori}
            categoryCode={item.categoryCode}
            alamat={item.alamat}
            kontak={item.kontak}
            linkGmaps={item.linkGmaps}
            linkFoto={item.linkFoto}
            rating={item.rating}
            reviewCount={item.reviewCount}
            rawItem={item.rawItem}
          />
        ))
      }
    </div>

    <!-- Empty State -->
    <div
      id="empty-state"
      style="display: none; text-align: center; padding: 3rem 0; color: var(--color-text-secondary);"
    >
      <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🔍</div>
      <p style="font-size: 1.1rem; font-weight: 600;">
        Tidak ada data yang cocok dengan pencarian Anda
      </p>
      <p style="font-size: 0.9rem; color: var(--color-text-muted);">
        Coba masukkan kata kunci lain atau reset filter kategori
      </p>
    </div>

    <!-- Pagination Controls -->
    <div class="pagination-wrapper" id="pagination-wrapper">
      <button
        class="pagination-btn"
        id="btn-prev"
        aria-label="Halaman sebelumnya"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><polyline points="15 18 9 12 15 6"></polyline></svg
        >
        Sebelumnya
      </button>
      <span class="pagination-info" id="pagination-info">Halaman 1 dari 1</span>
      <button
        class="pagination-btn"
        id="btn-next"
        aria-label="Halaman berikutnya"
      >
        Berikutnya
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><polyline points="9 18 15 12 9 6"></polyline></svg
        >
      </button>
    </div>
  </main>

  <!-- Modal Overlay Detail -->
  <div class="modal-overlay" id="detail-modal">
    <div class="modal-content">
      <button class="modal-close-btn" id="modal-close" aria-label="Tutup"
        >✕</button
      >
      <div class="modal-header">
        <span class="category-badge" id="modal-badge">KATEGORI</span>
        <h2 class="modal-title" id="modal-title">-</h2>
      </div>
      <div class="modal-body" id="modal-body"></div>
      <div class="modal-actions" id="modal-actions"></div>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const searchInput = document.getElementById(
      "search-input",
    ) as HTMLInputElement;
    const categoryPills = document.querySelectorAll(".category-pill");
    const allCards = Array.from(
      document.querySelectorAll(".listing-card"),
    ) as HTMLElement[];
    const emptyState = document.getElementById("empty-state");
    const paginationWrapper = document.getElementById("pagination-wrapper");
    const btnPrev = document.getElementById("btn-prev") as HTMLButtonElement;
    const btnNext = document.getElementById("btn-next") as HTMLButtonElement;
    const paginationInfo = document.getElementById("pagination-info");

    const PAGE_SIZE = 15;
    let activeCategory = "all";
    let searchQuery = "";
    let currentPage = 1;
    let filteredCards: HTMLElement[] = [];

    function getFilteredCards(): HTMLElement[] {
      return allCards.filter((el) => {
        const cardCategory = el.dataset.category || "";
        const searchData = el.dataset.search || "";
        const matchesCategory =
          activeCategory === "all" || cardCategory === activeCategory;
        const matchesSearch = !searchQuery || searchData.includes(searchQuery);
        return matchesCategory && matchesSearch;
      });
    }

    function renderPage() {
      filteredCards = getFilteredCards();
      const totalPages = Math.max(
        1,
        Math.ceil(filteredCards.length / PAGE_SIZE),
      );
      if (currentPage > totalPages) currentPage = totalPages;

      const start = (currentPage - 1) * PAGE_SIZE;
      const end = start + PAGE_SIZE;

      // Hide all, then show current page slice
      allCards.forEach((el) => (el.style.display = "none"));
      filteredCards
        .slice(start, end)
        .forEach((el) => (el.style.display = "flex"));

      if (emptyState) {
        emptyState.style.display =
          filteredCards.length === 0 ? "block" : "none";
      }

      // Update pagination UI
      if (paginationInfo) {
        paginationInfo.textContent = `Halaman ${currentPage} dari ${totalPages} · ${filteredCards.length} listing`;
      }
      if (btnPrev) btnPrev.disabled = currentPage <= 1;
      if (btnNext) btnNext.disabled = currentPage >= totalPages;
      if (paginationWrapper) {
        paginationWrapper.style.display =
          filteredCards.length <= PAGE_SIZE && currentPage === 1
            ? "none"
            : "flex";
      }
    }

    // Category Pill Click
    categoryPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        categoryPills.forEach((p) => p.classList.remove("active"));
        pill.classList.add("active");
        activeCategory = (pill as HTMLElement).dataset.category || "all";
        currentPage = 1;
        renderPage();
      });
    });

    // Search Input Change
    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        currentPage = 1;
        renderPage();
      });
    }

    // Pagination buttons
    btnPrev?.addEventListener("click", () => {
      if (currentPage > 1) {
        currentPage--;
        renderPage();
        document
          .getElementById("listing-list")
          ?.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });

    btnNext?.addEventListener("click", () => {
      const totalPages = Math.max(
        1,
        Math.ceil(filteredCards.length / PAGE_SIZE),
      );
      if (currentPage < totalPages) {
        currentPage++;
        renderPage();
        document
          .getElementById("listing-list")
          ?.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });

    // Check URL parameters for pre-selected category
    const urlParams = new URLSearchParams(window.location.search);
    const catParam = urlParams.get("category");
    if (catParam) {
      const targetPill = document.querySelector(
        `.category-pill[data-category="${catParam}"]`,
      ) as HTMLElement | null;
      if (targetPill) {
        targetPill.click();
      } else {
        renderPage();
      }
    } else {
      renderPage();
    }

    // Modal Interaction
    const modal = document.getElementById("detail-modal");
    const modalClose = document.getElementById("modal-close");
    const modalTitle = document.getElementById("modal-title");
    const modalBadge = document.getElementById("modal-badge");
    const modalBody = document.getElementById("modal-body");
    const modalActions = document.getElementById("modal-actions");

    allCards.forEach((card) => {
      card.addEventListener("click", () => {
        const rawStr = (card as HTMLElement).dataset.raw || "{}";
        let item: Record<string, any> = {};
        try {
          item = JSON.parse(rawStr);
        } catch (e) {
          return;
        }

        if (modalTitle) modalTitle.textContent = item.nama || "-";
        if (modalBadge)
          modalBadge.textContent = (item.kategori || "INFORMASI").toUpperCase();

        let detailsHTML = "";
        const fields = [
          { label: "Pengelola", key: "pengelola" },
          { label: "Alamat", key: "alamat" },
          { label: "Dusun", key: "dusun" },
          { label: "Pantai Terdekat", key: "pantaiTerdekat" },
          { label: "HTM", key: "htm" },
          { label: "Harga Weekday", key: "hargaWeekday" },
          { label: "Harga Weekend", key: "hargaWeekend" },
          { label: "Jam Operasional", key: "jamOperasional" },
          { label: "Daya Tarik", key: "dayaTarik" },
          { label: "Kontak", key: "kontak" },
          { label: "Media Sosial", key: "mediaSosial" },
          { label: "Instagram", key: "instagram" },
          { label: "QRIS", key: "qris" },
        ];

        fields.forEach(({ label, key }) => {
          if (item[key] && String(item[key]).trim() !== "") {
            detailsHTML += `
              <div class="detail-row">
                <span class="detail-label">${label}</span>
                <span class="detail-value">${item[key]}</span>
              </div>
            `;
          }
        });

        if (
          item.fasilitas &&
          Array.isArray(item.fasilitas) &&
          item.fasilitas.length > 0
        ) {
          detailsHTML += `
            <div class="detail-row">
              <span class="detail-label">Fasilitas</span>
              <span class="detail-value">${item.fasilitas.join(", ")}</span>
            </div>
          `;
        }

        if (modalBody)
          modalBody.innerHTML =
            detailsHTML ||
            '<p style="color: var(--color-text-muted);">Tidak ada detail informasi tambahan.</p>';

        // Actions
        let actionsHTML = "";
        if (item.kontak) {
          const cleanNum = String(item.kontak).replace(/\D/g, "");
          if (cleanNum) {
            actionsHTML += `<a href="https://wa.me/${cleanNum}" target="_blank" rel="noopener noreferrer" class="btn-whatsapp">💬 Hubungi via WhatsApp</a>`;
          }
        }

        const mapQuery =
          item.linkGmaps ||
          `https://maps.google.com/?q=${encodeURIComponent((item.nama || "") + " Watukarung Pacitan")}`;
        actionsHTML += `<a href="${mapQuery}" target="_blank" rel="noopener noreferrer" class="btn-maps">🗺️ Buka di Google Maps</a>`;

        if (modalActions) modalActions.innerHTML = actionsHTML;

        modal?.classList.add("active");
        document.body.style.overflow = "hidden";
      });
    });

    function closeModal() {
      modal?.classList.remove("active");
      document.body.style.overflow = "";
    }

    modalClose?.addEventListener("click", closeModal);
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeModal();
    });
  });
</script>
