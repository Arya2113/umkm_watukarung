---
/**
 * index.astro — Dashboard Utama JELAJAH Watukarung
 * Sesuai Mockup 2: Banner hero, Overview KPI, Peta & Info, Search & Category Filters, Listing horizontal, serta Modal Detail.
 */
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import HeroBanner from "../components/HeroBanner.astro";
import KpiCard from "../components/KpiCard.astro";
import MapPreview from "../components/MapPreview.astro";
import InfoPanel from "../components/InfoPanel.astro";
import ListingCard from "../components/ListingCard.astro";
import UmkmAnalytics from "../components/UmkmAnalytics.astro";

// Import 5 file data JSON
import destinasi from "../data/destinasi.json";
import akomodasi from "../data/akomodasi.json";
import kuliner from "../data/kuliner.json";
import jasa from "../data/jasa.json";
import penunjang from "../data/penunjang.json";

// Siapkan gabungan data listing
const allListings = [
  ...destinasi.map((item, i) => ({
    id: `destinasi-${i}`,
    nama: item.nama,
    kategori: item.kategori || "Destinasi Wisata",
    categoryCode: "destinasi",
    alamat: item.alamat,
    kontak: item.kontak,
    linkGmaps: item.linkGmaps,
    linkFoto: item.linkFoto,
    rating: (4.7 + (i % 3) * 0.1).toFixed(1),
    reviewCount: `${100 + i * 15}`,
    rawItem: item,
  })),
  ...akomodasi.map((item, i) => ({
    id: `akomodasi-${i}`,
    nama: item.nama,
    kategori: item.kategori || "Akomodasi",
    categoryCode: "akomodasi",
    alamat: item.alamat,
    kontak: item.kontak,
    linkGmaps: item.linkGmaps,
    linkFoto: (item as any).linkFoto,
    rating: (4.6 + (i % 4) * 0.1).toFixed(1),
    reviewCount: `${50 + i * 12}`,
    rawItem: item,
  })),
  ...kuliner.map((item, i) => ({
    id: `kuliner-${i}`,
    nama: item.nama,
    kategori: item.kategori || "Kuliner & UMKM",
    categoryCode: "kuliner",
    alamat: item.alamat,
    kontak: item.kontak,
    linkGmaps: item.linkGmaps,
    linkFoto: (item as any).linkFoto,
    rating: (4.7 + (i % 3) * 0.1).toFixed(1),
    reviewCount: `${30 + i * 8}`,
    rawItem: item,
  })),
  ...jasa.map((item, i) => ({
    id: `jasa-${i}`,
    nama: item.nama,
    kategori:
      (item as any).kategori || (item as any).jenisLayanan || "Jasa Wisata",
    categoryCode: "jasa",
    alamat: item.alamat,
    kontak: item.kontak,
    linkGmaps: item.linkGmaps,
    linkFoto: (item as any).linkFoto,
    rating: "4.9",
    reviewCount: `${40 + i * 10}`,
    rawItem: item,
  })),
  ...penunjang.map((item, i) => ({
    id: `penunjang-${i}`,
    nama: item.nama,
    kategori:
      (item as any).kategori || (item as any).jenis || "Fasilitas Penunjang",
    categoryCode: "penunjang",
    alamat: item.alamat,
    kontak: item.kontak,
    linkGmaps: item.linkGmaps,
    linkFoto: (item as any).linkFoto,
    rating: "4.8",
    reviewCount: `${20 + i * 5}`,
    rawItem: item,
  })),
];
---

<Layout title="Dashboard">
  <Navbar />

  <!-- Hero Banner -->
  <HeroBanner />

  <main class="max-w-container mx-auto px-5">
    <!-- Overview Section -->
    <section class="pt-10 pb-6">
      <div class="fade-in mb-6">
        <h2 class="text-[30px] font-bold text-text-primary mb-1">Overview</h2>
        <p class="text-[15px] text-text-secondary">
          Welcome back to the Watukarung tourism dashboard.
        </p>
      </div>

      <!-- 4 KPI Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
        <KpiCard icon="users" label="Total Visitors" value="12,450" />
        <KpiCard icon="map-pin" label="Popular Spots" value="8" />
        <KpiCard icon="star" label="Total Reviews" value="3,205" />
        <KpiCard icon="bed" label="Active Lodgings" value="42" />
      </div>
    </section>

    <!-- UMKM Analytics Section -->
    <UmkmAnalytics />

    <!-- Map & Info Side-by-Side Grid -->
    <section class="mb-10">
      <div class="grid grid-cols-1 lg:grid-cols-[1.75fr_1fr] gap-6">
        <MapPreview />
        <InfoPanel />
      </div>
    </section>

    <!-- Search & Category Filters Section -->
    <section class="mb-8">
      <!-- Search Input Bar -->
      <div class="fade-in relative w-full mb-4">
        <i data-lucide="search"
          class="absolute left-5 top-1/2 -translate-y-1/2 text-text-muted w-[18px] h-[18px] pointer-events-none"></i>
        <input
          type="text"
          id="search-input"
          class="w-full py-3.5 pl-12 pr-5 rounded-pill border border-border bg-surface text-[15px] text-text-primary shadow-sm outline-none transition-all duration-150 focus:border-primary focus:shadow-[0_4px_16px_rgba(14,79,76,0.12)]"
          placeholder="Cari destinasi, penginapan, kuliner..."
          autocomplete="off"
        />
      </div>

      <!-- Category Filter Pills -->
      <div class="fade-in flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none" id="category-pills">
        <button
          class="category-pill active px-5 py-2 rounded-pill text-sm font-semibold border border-border bg-surface text-text-secondary whitespace-nowrap transition-all duration-150 hover:border-primary hover:text-primary"
          data-category="all">All Destinasi Wisata</button>
        <button
          class="category-pill px-5 py-2 rounded-pill text-sm font-semibold border border-border bg-surface text-text-secondary whitespace-nowrap transition-all duration-150 hover:border-primary hover:text-primary"
          data-category="destinasi">Destinasi Wisata</button>
        <button
          class="category-pill px-5 py-2 rounded-pill text-sm font-semibold border border-border bg-surface text-text-secondary whitespace-nowrap transition-all duration-150 hover:border-primary hover:text-primary"
          data-category="akomodasi">Akomodasi</button>
        <button
          class="category-pill px-5 py-2 rounded-pill text-sm font-semibold border border-border bg-surface text-text-secondary whitespace-nowrap transition-all duration-150 hover:border-primary hover:text-primary"
          data-category="kuliner">Kuliner & UMKM</button>
        <button
          class="category-pill px-5 py-2 rounded-pill text-sm font-semibold border border-border bg-surface text-text-secondary whitespace-nowrap transition-all duration-150 hover:border-primary hover:text-primary"
          data-category="jasa">Jasa Wisata</button>
        <button
          class="category-pill px-5 py-2 rounded-pill text-sm font-semibold border border-border bg-surface text-text-secondary whitespace-nowrap transition-all duration-150 hover:border-primary hover:text-primary"
          data-category="penunjang">Penunjang</button>
      </div>
    </section>

    <!-- Listings Grid/List -->
    <div class="flex flex-col gap-5 mb-6" id="listing-list">
      {
        allListings.map((item) => (
          <ListingCard
            id={item.id}
            nama={item.nama}
            kategori={item.kategori}
            categoryCode={item.categoryCode}
            alamat={item.alamat}
            kontak={item.kontak}
            linkGmaps={item.linkGmaps}
            linkFoto={item.linkFoto}
            rating={item.rating}
            reviewCount={item.reviewCount}
            rawItem={item.rawItem}
          />
        ))
      }
    </div>

    <!-- Empty State -->
    <div
      id="empty-state"
      class="text-center py-12 text-text-secondary"
      style="display: none;"
    >
      <div class="text-[2.5rem] mb-2">🔍</div>
      <p class="text-[1.1rem] font-semibold">
        Tidak ada data yang cocok dengan pencarian Anda
      </p>
      <p class="text-[0.9rem] text-text-muted">
        Coba masukkan kata kunci lain atau reset filter kategori
      </p>
    </div>

    <!-- Pagination Controls -->
    <div class="flex items-center justify-center gap-4 mb-12 flex-wrap" id="pagination-wrapper">
      <button
        class="pagination-btn inline-flex items-center gap-1.5 px-5 py-2 rounded-pill border border-border bg-surface text-text-primary text-sm font-semibold cursor-pointer transition-all duration-[250ms] hover:bg-primary hover:text-white hover:border-primary hover:-translate-y-px disabled:opacity-35 disabled:cursor-not-allowed"
        id="btn-prev"
        aria-label="Halaman sebelumnya"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        Sebelumnya
      </button>
      <span class="text-sm font-medium text-text-secondary whitespace-nowrap" id="pagination-info">Halaman 1 dari 1</span>
      <button
        class="pagination-btn inline-flex items-center gap-1.5 px-5 py-2 rounded-pill border border-border bg-surface text-text-primary text-sm font-semibold cursor-pointer transition-all duration-[250ms] hover:bg-primary hover:text-white hover:border-primary hover:-translate-y-px disabled:opacity-35 disabled:cursor-not-allowed"
        id="btn-next"
        aria-label="Halaman berikutnya"
      >
        Berikutnya
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
  </main>

  <!-- Modal Overlay Detail -->
  <div
    class="fixed inset-0 z-[2000] hidden items-center justify-center p-4"
    style="background: rgba(22, 48, 46, 0.6); backdrop-filter: blur(4px);"
    id="detail-modal"
  >
    <div class="modal-slide-up bg-surface rounded-card max-w-[580px] w-full max-h-[85vh] overflow-y-auto shadow-modal relative">
      <button
        class="absolute top-5 right-5 w-9 h-9 rounded-full bg-bg-bottom text-text-primary flex items-center justify-center text-lg cursor-pointer transition-colors duration-150 hover:bg-primary-light"
        id="modal-close"
        aria-label="Tutup">✕</button>
      <div class="px-6 pt-6 pb-4 border-b border-border">
        <span class="inline-block bg-primary-dark text-white text-[11px] font-bold tracking-[0.05em] uppercase px-2 py-0.5 rounded-[6px]" id="modal-badge">KATEGORI</span>
        <h2 class="text-[22px] font-extrabold text-text-primary mt-2" id="modal-title">-</h2>
      </div>
      <div class="px-6 py-5" id="modal-body"></div>
      <div class="px-6 pb-6 flex gap-3 flex-wrap" id="modal-actions"></div>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const searchInput = document.getElementById(
      "search-input",
    ) as HTMLInputElement;
    const categoryPills = document.querySelectorAll(".category-pill");
    const allCards = Array.from(
      document.querySelectorAll(".listing-card"),
    ) as HTMLElement[];
    const emptyState = document.getElementById("empty-state");
    const paginationWrapper = document.getElementById("pagination-wrapper");
    const btnPrev = document.getElementById("btn-prev") as HTMLButtonElement;
    const btnNext = document.getElementById("btn-next") as HTMLButtonElement;
    const paginationInfo = document.getElementById("pagination-info");

    const PAGE_SIZE = 15;
    let activeCategory = "all";
    let searchQuery = "";
    let currentPage = 1;
    let filteredCards: HTMLElement[] = [];

    function getFilteredCards(): HTMLElement[] {
      return allCards.filter((el) => {
        const cardCategory = el.dataset.category || "";
        const searchData = el.dataset.search || "";
        const matchesCategory =
          activeCategory === "all" || cardCategory === activeCategory;
        const matchesSearch = !searchQuery || searchData.includes(searchQuery);
        return matchesCategory && matchesSearch;
      });
    }

    function renderPage() {
      filteredCards = getFilteredCards();
      const totalPages = Math.max(
        1,
        Math.ceil(filteredCards.length / PAGE_SIZE),
      );
      if (currentPage > totalPages) currentPage = totalPages;

      const start = (currentPage - 1) * PAGE_SIZE;
      const end = start + PAGE_SIZE;

      // Hide all, then show current page slice
      allCards.forEach((el) => (el.style.display = "none"));
      filteredCards
        .slice(start, end)
        .forEach((el) => (el.style.display = "flex"));

      if (emptyState) {
        emptyState.style.display =
          filteredCards.length === 0 ? "block" : "none";
      }

      // Update pagination UI
      if (paginationInfo) {
        paginationInfo.textContent = `Halaman ${currentPage} dari ${totalPages} · ${filteredCards.length} listing`;
      }
      if (btnPrev) btnPrev.disabled = currentPage <= 1;
      if (btnNext) btnNext.disabled = currentPage >= totalPages;
      if (paginationWrapper) {
        paginationWrapper.style.display =
          filteredCards.length <= PAGE_SIZE && currentPage === 1
            ? "none"
            : "flex";
      }
    }

    // Category Pill Click
    categoryPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        categoryPills.forEach((p) => p.classList.remove("active"));
        pill.classList.add("active");
        activeCategory = (pill as HTMLElement).dataset.category || "all";
        currentPage = 1;
        renderPage();
      });
    });

    // Search Input Change
    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        currentPage = 1;
        renderPage();
      });
    }

    // Pagination buttons
    btnPrev?.addEventListener("click", () => {
      if (currentPage > 1) {
        currentPage--;
        renderPage();
        document
          .getElementById("listing-list")
          ?.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });

    btnNext?.addEventListener("click", () => {
      const totalPages = Math.max(
        1,
        Math.ceil(filteredCards.length / PAGE_SIZE),
      );
      if (currentPage < totalPages) {
        currentPage++;
        renderPage();
        document
          .getElementById("listing-list")
          ?.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });

    // Check URL parameters for pre-selected category
    const urlParams = new URLSearchParams(window.location.search);
    const catParam = urlParams.get("category");
    if (catParam) {
      const targetPill = document.querySelector(
        `.category-pill[data-category="${catParam}"]`,
      ) as HTMLElement | null;
      if (targetPill) {
        targetPill.click();
      } else {
        renderPage();
      }
    } else {
      renderPage();
    }

    // Modal Interaction
    const modal = document.getElementById("detail-modal");
    const modalClose = document.getElementById("modal-close");
    const modalTitle = document.getElementById("modal-title");
    const modalBadge = document.getElementById("modal-badge");
    const modalBody = document.getElementById("modal-body");
    const modalActions = document.getElementById("modal-actions");

    allCards.forEach((card) => {
      card.addEventListener("click", () => {
        const rawStr = (card as HTMLElement).dataset.raw || "{}";
        let item: Record<string, any> = {};
        try {
          item = JSON.parse(rawStr);
        } catch (e) {
          return;
        }

        if (modalTitle) modalTitle.textContent = item.nama || "-";
        if (modalBadge)
          modalBadge.textContent = (item.kategori || "INFORMASI").toUpperCase();

        let detailsHTML = "";
        const fields = [
          { label: "Pengelola", key: "pengelola" },
          { label: "Alamat", key: "alamat" },
          { label: "Dusun", key: "dusun" },
          { label: "Pantai Terdekat", key: "pantaiTerdekat" },
          { label: "HTM", key: "htm" },
          { label: "Harga Weekday", key: "hargaWeekday" },
          { label: "Harga Weekend", key: "hargaWeekend" },
          { label: "Jam Operasional", key: "jamOperasional" },
          { label: "Daya Tarik", key: "dayaTarik" },
          { label: "Kontak", key: "kontak" },
          { label: "Media Sosial", key: "mediaSosial" },
          { label: "Instagram", key: "instagram" },
          { label: "QRIS", key: "qris" },
        ];

        fields.forEach(({ label, key }) => {
          if (item[key] && String(item[key]).trim() !== "") {
            detailsHTML += `
              <div style="display:flex;align-items:flex-start;padding:0.6rem 0;border-bottom:1px solid #F3ECE1;font-size:14px;">
                <span style="width:120px;font-weight:600;color:#6E7378;flex-shrink:0;">${label}</span>
                <span style="color:#17181A;word-break:break-word;">${item[key]}</span>
              </div>
            `;
          }
        });

        if (
          item.fasilitas &&
          Array.isArray(item.fasilitas) &&
          item.fasilitas.length > 0
        ) {
          detailsHTML += `
            <div style="display:flex;align-items:flex-start;padding:0.6rem 0;border-bottom:1px solid #F3ECE1;font-size:14px;">
              <span style="width:120px;font-weight:600;color:#6E7378;flex-shrink:0;">Fasilitas</span>
              <span style="color:#17181A;word-break:break-word;">${item.fasilitas.join(", ")}</span>
            </div>
          `;
        }

        if (modalBody)
          modalBody.innerHTML =
            detailsHTML ||
            '<p style="color:#9CA0A6;">Tidak ada detail informasi tambahan.</p>';

        // Actions
        let actionsHTML = "";
        if (item.kontak) {
          const cleanNum = String(item.kontak).replace(/\D/g, "");
          if (cleanNum) {
            actionsHTML += `<a href="https://wa.me/${cleanNum}" target="_blank" rel="noopener noreferrer" style="background:#25D366;color:#fff;font-size:13px;font-weight:700;padding:0.6rem 1rem;border-radius:10px;display:inline-flex;align-items:center;gap:0.4rem;text-decoration:none;">💬 Hubungi via WhatsApp</a>`;
          }
        }

        const mapQuery =
          item.linkGmaps ||
          `https://maps.google.com/?q=${encodeURIComponent((item.nama || "") + " Watukarung Pacitan")}`;
        actionsHTML += `<a href="${mapQuery}" target="_blank" rel="noopener noreferrer" style="background:#0E4F4C;color:#fff;font-size:13px;font-weight:700;padding:0.6rem 1rem;border-radius:10px;display:inline-flex;align-items:center;gap:0.4rem;text-decoration:none;">🗺️ Buka di Google Maps</a>`;

        if (modalActions) modalActions.innerHTML = actionsHTML;

        // Show modal - use flex display
        if (modal) {
          modal.style.display = "flex";
        }
        document.body.style.overflow = "hidden";
      });
    });

    function closeModal() {
      if (modal) {
        modal.style.display = "none";
      }
      document.body.style.overflow = "";
    }

    modalClose?.addEventListener("click", closeModal);
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeModal();
    });
  });
</script>
