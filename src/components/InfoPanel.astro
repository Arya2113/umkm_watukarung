---
/**
 * InfoPanel.astro — Live Conditions Widget (Sesuai Desain Mockup)
 */
---

<div class="fade-in bg-surface rounded-card border border-border shadow-card p-6 relative overflow-hidden flex flex-col justify-start h-auto self-start">
  <!-- Soft Background Glow Element (Top Right) -->
  <div class="absolute top-0 right-0 w-44 h-44 bg-gradient-to-bl from-[#FFF0D4]/70 via-[#E4F3EF]/40 to-transparent rounded-bl-full pointer-events-none z-0"></div>

  <!-- Header Row -->
  <div class="flex items-center justify-between relative z-10 mb-2">
    <h3 class="text-[22px] font-bold text-[#0E4F4C] tracking-tight">
      Live Conditions
    </h3>
    <span id="tide-badge" class="inline-flex items-center gap-1.5 text-[12px] font-bold text-[#0E4F4C] bg-[#D0E7E3] px-3 py-1 rounded-full border border-[#BBE0DA]">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"></path>
        <path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"></path>
      </svg>
      Tide: High
    </span>
  </div>

  <!-- Weather & Temperature Display -->
  <div class="flex items-center justify-between relative z-10 my-3">
    <div>
      <div id="weather-temp" class="text-[44px] font-black text-[#0E4F4C] leading-none tracking-tight">
        28°C
      </div>
      <div id="weather-desc" class="text-[14px] font-semibold text-text-secondary mt-1.5">
        Sunny, Light Breeze
      </div>
    </div>
    <div id="weather-icon-box" class="flex items-center justify-center p-1">
      <svg class="w-16 h-16 text-[#F59E0B] drop-shadow-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4" fill="#F59E0B"></circle>
        <path d="M12 2v2"></path>
        <path d="M12 20v2"></path>
        <path d="m4.93 4.93 1.41 1.41"></path>
        <path d="m17.66 17.66 1.41 1.41"></path>
        <path d="M2 12h2"></path>
        <path d="M22 12h-2"></path>
        <path d="m6.34 17.66-1.41 1.41"></path>
        <path d="m19.07 4.93-1.41 1.41"></path>
      </svg>
    </div>
  </div>

  <!-- Time & Date Sub-Card -->
  <div class="bg-[#F8F4EE] border border-[#ECE4D6] rounded-xl p-4 grid grid-cols-2 gap-2 relative z-10 my-2">
    <!-- Time Column -->
    <div class="border-r border-[#E2D8C7] pr-3 flex flex-col justify-center">
      <span class="text-[12px] font-bold text-[#6E7378] uppercase tracking-wider mb-1">Time</span>
      <div class="flex items-baseline gap-1.5">
        <span id="live-time" class="text-[22px] font-extrabold text-[#17181A] leading-none font-mono">14:30</span>
        <span class="text-[12px] font-bold text-[#17181A]">WIB</span>
      </div>
    </div>

    <!-- Date Column -->
    <div class="pl-2 flex flex-col justify-center">
      <span class="text-[12px] font-bold text-[#6E7378] uppercase tracking-wider mb-1">Date</span>
      <div class="flex items-baseline gap-1.5">
        <span id="live-day-num" class="text-[22px] font-extrabold text-[#17181A] leading-none">15</span>
        <span id="live-month-year" class="text-[14px] font-bold text-[#17181A]">Aug 2026</span>
      </div>
    </div>
  </div>

  <!-- Bottom Divider Line -->
  <div class="border-b border-border-light pt-2 relative z-10"></div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // 1. Live Time & Date Updater
    const timeEl = document.getElementById("live-time");
    const dayNumEl = document.getElementById("live-day-num");
    const monthYearEl = document.getElementById("live-month-year");

    const monthsEng = [
      "Jan", "Feb", "Mar", "Apr", "May", "Jun",
      "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
    ];

    function updateTimeAndDate() {
      const now = new Date();

      const hours = String(now.getHours()).padStart(2, "0");
      const minutes = String(now.getMinutes()).padStart(2, "0");
      if (timeEl) {
        timeEl.textContent = `${hours}:${minutes}`;
      }

      const dayNum = now.getDate();
      const monthName = monthsEng[now.getMonth()];
      const year = now.getFullYear();

      if (dayNumEl) dayNumEl.textContent = String(dayNum);
      if (monthYearEl) monthYearEl.textContent = `${monthName} ${year}`;
    }

    updateTimeAndDate();
    setInterval(updateTimeAndDate, 1000);

    // 2. Weather Live Fetch for Watukarung (-8.258, 111.091)
    const tempEl = document.getElementById("weather-temp");
    const descEl = document.getElementById("weather-desc");
    const iconBoxEl = document.getElementById("weather-icon-box");

    function getWeatherGraphic(code: number) {
      if (code === 0) {
        return {
          desc: "Sunny, Clear Sky",
          svg: `<svg class="w-16 h-16 text-[#F59E0B] drop-shadow-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" fill="#F59E0B"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M22 12h-2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>`
        };
      }
      if (code >= 1 && code <= 3) {
        return {
          desc: "Sunny, Light Breeze",
          svg: `<svg class="w-16 h-16 text-[#F59E0B] drop-shadow-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="M20 12h2"></path><path d="m19.07 19.07-1.41-1.41"></path><path d="M15.9 11.9A5 5 0 0 0 7 13h-.5a3.5 3.5 0 0 0 0 7h12.5a4.5 4.5 0 0 0 0-9h-.1a6 6 0 0 0-3.5-2Z" fill="#FCE7F3" stroke="#F59E0B"></path></svg>`
        };
      }
      if (code >= 51) {
        return {
          desc: "Light Rain, Breeze",
          svg: `<svg class="w-16 h-16 text-[#0D9488]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14.8A7 7 0 0 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.2"></path><path d="M16 14v6"></path><path d="M8 14v6"></path><path d="M12 16v6"></path></svg>`
        };
      }
      return {
        desc: "Sunny, Light Breeze",
        svg: `<svg class="w-16 h-16 text-[#F59E0B] drop-shadow-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" fill="#F59E0B"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M22 12h-2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>`
      };
    }

    async function fetchWeather() {
      try {
        const res = await fetch(
          "https://api.open-meteo.com/v1/forecast?latitude=-8.258&longitude=111.091&current_weather=true&timezone=Asia%2FJakarta"
        );
        if (!res.ok) throw new Error("Weather fetch error");
        const data = await res.json();
        if (data && data.current_weather) {
          const temp = Math.round(data.current_weather.temperature);
          const graphic = getWeatherGraphic(data.current_weather.weathercode);

          if (tempEl) tempEl.textContent = `${temp}°C`;
          if (descEl) descEl.textContent = graphic.desc;
          if (iconBoxEl) iconBoxEl.innerHTML = graphic.svg;
        }
      } catch (err) {
        if (tempEl && tempEl.textContent === "--°C") {
          if (tempEl) tempEl.textContent = "28°C";
          if (descEl) descEl.textContent = "Sunny, Light Breeze";
        }
      }
    }

    fetchWeather();
    setInterval(fetchWeather, 600000);
  });
</script>


