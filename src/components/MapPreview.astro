---
/**
 * MapPreview.astro — Peta Interaktif Watukarung dengan Leaflet.js
 * Menampilkan pin nyata dari semua dataset (linkGmaps di-parse untuk lat/lng).
 * 106 dari 189 item memiliki koordinat valid.
 */
import kuliner from "../data/kuliner.json";
import akomodasi from "../data/akomodasi.json";
import destinasi from "../data/destinasi.json";
import jasa from "../data/jasa.json";
import penunjang from "../data/penunjang.json";

// Parse koordinat dari field latitude/longitude atau linkGmaps
function getItemCoords(item: any): { lat: number; lng: number } | null {
  if (item.latitude && item.longitude) {
    const lat = parseFloat(String(item.latitude).trim());
    const lng = parseFloat(String(item.longitude).trim());
    if (!isNaN(lat) && !isNaN(lng) && lat !== 0 && lng !== 0) {
      return { lat, lng };
    }
  }
  if (item.lat && item.lng) {
    const lat = parseFloat(String(item.lat).trim());
    const lng = parseFloat(String(item.lng).trim());
    if (!isNaN(lat) && !isNaN(lng) && lat !== 0 && lng !== 0) {
      return { lat, lng };
    }
  }
  return extractCoords(item.linkGmaps);
}

function extractCoords(
  url: string | undefined,
): { lat: number; lng: number } | null {
  if (!url || url.trim() === "") return null;
  // Pattern 1: @lat,lng,zoom
  const m1 = url.match(/@(-?\d+\.\d+),(-?\d+\.\d+)/);
  if (m1) return { lat: parseFloat(m1[1]), lng: parseFloat(m1[2]) };
  // Pattern 2: !3dLAT!4dLNG
  const m2 = url.match(/!3d(-?\d+\.\d+)!4d(-?\d+\.\d+)/);
  if (m2) return { lat: parseFloat(m2[1]), lng: parseFloat(m2[2]) };
  return null;
}

// Bangun array marker dengan kategori
const markers: {
  lat: number;
  lng: number;
  nama: string;
  kategori: string;
  categoryCode: string;
  kontak?: string;
  linkGmaps?: string;
}[] = [];

kuliner.forEach((item: any) => {
  const coords = getItemCoords(item);
  if (coords)
    markers.push({
      ...coords,
      nama: item.nama,
      kategori: item.kategori || "Kuliner & UMKM",
      categoryCode: "kuliner",
      kontak: item.kontak,
      linkGmaps: item.linkGmaps,
    });
});
akomodasi.forEach((item: any) => {
  const coords = getItemCoords(item);
  if (coords)
    markers.push({
      ...coords,
      nama: item.nama,
      kategori: item.kategori || "Akomodasi",
      categoryCode: "akomodasi",
      kontak: item.kontak,
      linkGmaps: item.linkGmaps,
    });
});
destinasi.forEach((item: any) => {
  const coords = getItemCoords(item);
  if (coords)
    markers.push({
      ...coords,
      nama: item.nama,
      kategori: item.kategori || "Destinasi",
      categoryCode: "destinasi",
      kontak: item.kontak,
      linkGmaps: item.linkGmaps,
    });
});
jasa.forEach((item: any) => {
  const coords = getItemCoords(item);
  if (coords)
    markers.push({
      ...coords,
      nama: item.nama,
      kategori: item.jenisLayanan || "Jasa Wisata",
      categoryCode: "jasa",
      kontak: item.kontak,
      linkGmaps: item.linkGmaps,
    });
});
penunjang.forEach((item: any) => {
  const coords = getItemCoords(item);
  if (coords)
    markers.push({
      ...coords,
      nama: item.nama,
      kategori: item.jenis || "Penunjang",
      categoryCode: "penunjang",
      kontak: item.kontak,
      linkGmaps: item.linkGmaps,
    });
});

const markersJSON = JSON.stringify(markers);
const totalMarkers = markers.length;
---

<div
  class="fade-in bg-surface rounded-card border border-border shadow-card overflow-hidden flex flex-col relative"
>
  <!-- Map Legend (category filter) -->
  <div
    class="flex items-center gap-2 px-4 py-2.5 bg-[#F8FAF9] border-b border-border overflow-x-auto scrollbar-none flex-wrap"
  >
    <button
      class="map-legend-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-pill text-[12px] font-bold border-[1.5px] border-border bg-white text-text-secondary cursor-pointer whitespace-nowrap transition-all duration-150 hover:border-primary hover:text-primary map-btn-active-all active"
      data-filter="all">Semua</button
    >
    <button
      class="map-legend-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-pill text-[12px] font-bold border-[1.5px] border-border bg-white text-text-secondary cursor-pointer whitespace-nowrap transition-all duration-150"
      data-filter="destinasi"
    >
      <span
        class="w-2 h-2 rounded-full inline-block flex-shrink-0"
        style="background:#0891B2;"></span> Wisata
    </button>
    <button
      class="map-legend-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-pill text-[12px] font-bold border-[1.5px] border-border bg-white text-text-secondary cursor-pointer whitespace-nowrap transition-all duration-150"
      data-filter="kuliner"
    >
      <span
        class="w-2 h-2 rounded-full inline-block flex-shrink-0"
        style="background:#16A34A;"></span> Kuliner
    </button>
    <button
      class="map-legend-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-pill text-[12px] font-bold border-[1.5px] border-border bg-white text-text-secondary cursor-pointer whitespace-nowrap transition-all duration-150"
      data-filter="akomodasi"
    >
      <span
        class="w-2 h-2 rounded-full inline-block flex-shrink-0"
        style="background:#7C3AED;"></span> Akomodasi
    </button>
    <button
      class="map-legend-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-pill text-[12px] font-bold border-[1.5px] border-border bg-white text-text-secondary cursor-pointer whitespace-nowrap transition-all duration-150"
      data-filter="penunjang"
    >
      <span
        class="w-2 h-2 rounded-full inline-block flex-shrink-0"
        style="background:#DC2626;"></span> Penunjang
    </button>
  </div>

  <div id="watukarung-map" class="w-full" style="height: 340px; border: none;">
  </div>
</div>

<!-- Leaflet CSS -->
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<script define:vars={{ markersJSON, totalMarkers }}>
  function initMap() {
    const markers = JSON.parse(markersJSON);

    // Init map
    const map = L.map("watukarung-map", {
      center: [-8.2316, 110.9723],
      zoom: 14,
      zoomControl: true,
      scrollWheelZoom: false,
    });

    // Tile layer (OpenStreetMap)
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution:
        '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 19,
    }).addTo(map);

    // Color & emoji per category
    const categoryColors = {
      kuliner: "#16A34A",
      akomodasi: "#7C3AED",
      destinasi: "#0891B2",
      jasa: "#EA580C",
      penunjang: "#DC2626",
    };
    const categoryEmoji = {
      kuliner: "🍽️",
      akomodasi: "🏡",
      destinasi: "🏖️",
      jasa: "🏄",
      penunjang: "🏪",
    };

    function createIcon(color) {
      return L.divIcon({
        className: "",
        html: `<div style="
          width:12px;height:12px;border-radius:50%;
          background:${color};border:2px solid #fff;
          box-shadow:0 1px 4px rgba(0,0,0,0.4);
        "></div>`,
        iconSize: [12, 12],
        iconAnchor: [6, 6],
        popupAnchor: [0, -8],
      });
    }

    // Add markers
    const leafletMarkers = markers.map((m) => {
      const color = categoryColors[m.categoryCode] || "#666";
      const emoji = categoryEmoji[m.categoryCode] || "📍";
      const cleanNum = m.kontak ? String(m.kontak).replace(/\D/g, "") : "";
      const waUrl = cleanNum ? `https://wa.me/${cleanNum}` : null;

      const popupContent = `
        <div style="font-family:system-ui,sans-serif;min-width:180px;padding:2px;">
          <div style="font-weight:800;font-size:13px;color:#17181A;margin-bottom:4px;">${emoji} ${m.nama}</div>
          <div style="font-size:10px;font-weight:700;color:#fff;background:${color};display:inline-block;padding:2px 8px;border-radius:999px;margin-bottom:8px;">${m.kategori}</div>
          <div style="display:flex;gap:5px;flex-wrap:wrap;">
            ${waUrl ? `<a href="${waUrl}" target="_blank" style="font-size:11px;font-weight:700;background:#25D366;color:#fff;padding:4px 8px;border-radius:6px;text-decoration:none;">💬 WA</a>` : ""}
            ${m.linkGmaps ? `<a href="${m.linkGmaps}" target="_blank" style="font-size:11px;font-weight:700;background:#0E4F4C;color:#fff;padding:4px 8px;border-radius:6px;text-decoration:none;">🗺️ Maps</a>` : ""}
          </div>
        </div>`;

      const marker = L.marker([m.lat, m.lng], { icon: createIcon(color) })
        .addTo(map)
        .bindPopup(popupContent, { maxWidth: 240 });
      marker._categoryCode = m.categoryCode;
      return marker;
    });

    // Category filter buttons
    const filterMap = {
      all: ["kuliner", "akomodasi", "destinasi", "jasa", "penunjang"],
      destinasi: ["destinasi"],
      kuliner: ["kuliner"],
      akomodasi: ["akomodasi"],
      penunjang: ["penunjang"],
    };

    const activeClassMap = {
      all: "map-btn-active-all",
      destinasi: "map-btn-active-destinasi",
      kuliner: "map-btn-active-kuliner",
      akomodasi: "map-btn-active-akomodasi",
      penunjang: "map-btn-active-penunjang",
    };

    document.querySelectorAll(".map-legend-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        // Remove all active classes
        document.querySelectorAll(".map-legend-btn").forEach((b) => {
          Object.values(activeClassMap).forEach((cls) =>
            b.classList.remove(cls),
          );
          b.classList.remove("active");
        });
        btn.classList.add("active");
        const filter = btn.dataset.filter;
        const activeClass = activeClassMap[filter];
        if (activeClass) btn.classList.add(activeClass);

        const allowed = filterMap[filter] || [filter];
        leafletMarkers.forEach((m) => {
          if (allowed.includes(m._categoryCode)) {
            m.addTo(map);
          } else {
            map.removeLayer(m);
          }
        });
      });
    });

    // Enable scroll wheel zoom on map click
    map.on("click", () => map.scrollWheelZoom.enable());
  }

  // Load Leaflet JS dynamically then init map
  document.addEventListener("DOMContentLoaded", () => {
    const script = document.createElement("script");
    script.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
    script.onload = initMap;
    document.head.appendChild(script);
  });
</script>
