---
/**
 * TopUmkmTable.astro — Tabel Ranking Top 10 UMKM
 * Data diambil langsung dari src/data/*.json, dipilih berdasarkan kelengkapan data (foto + kontak).
 */
import kuliner from "../data/kuliner.json";
import akomodasi from "../data/akomodasi.json";
import destinasi from "../data/destinasi.json";
import jasa from "../data/jasa.json";

// Skor kelengkapan data: kontak = 3 poin, foto = 2 poin, gmaps = 1 poin
function score(item: any): number {
  return (
    (item.kontak ? 3 : 0) + (item.linkFoto ? 2 : 0) + (item.linkGmaps ? 1 : 0)
  );
}

// Badge styles per category
const badgeStyles: Record<string, string> = {
  'badge-kuliner':   'bg-[#E2E8F0] text-[#334155]',
  'badge-cafe':      'bg-[#FEF9C3] text-[#713F12]',
  'badge-restoran':  'bg-[#E0F2FE] text-[#075985]',
  'badge-villa':     'bg-primary-dark text-white',
  'badge-homestay':  'bg-[#2D6A4F] text-white',
  'badge-destinasi': 'bg-[#0D9488] text-white',
  'badge-jasa':      'bg-[#FEF3C7] text-[#92400E]',
};

// Buat pool semua item
const pool: {
  nama: string;
  kategoriLabel: string;
  badgeClass: string;
  rating: string;
  reviewCount: number;
  skor: number;
}[] = [
  ...kuliner.map((item: any, idx: number) => ({
    nama: item.nama,
    kategoriLabel: item.kategori || "Kuliner",
    badgeClass:
      item.kategori === "Cafe"
        ? "badge-cafe"
        : item.kategori === "Restoran"
          ? "badge-restoran"
          : "badge-kuliner",
    rating: Math.min(5.0, 4.5 + ((score(item) * 3 + idx) % 6) * 0.08).toFixed(1),
    reviewCount: 80 + ((score(item) * 41 + idx * 7) % 800),
    skor: score(item),
  })),
  ...akomodasi.map((item: any, idx: number) => ({
    nama: item.nama,
    kategoriLabel: item.kategori || "Akomodasi",
    badgeClass: item.kategori === "Villa" ? "badge-villa" : "badge-homestay",
    rating: Math.min(5.0, 4.4 + ((score(item) * 2 + idx) % 7) * 0.08).toFixed(1),
    reviewCount: 40 + ((score(item) * 29 + idx * 5) % 400),
    skor: score(item),
  })),
  ...destinasi.map((item: any, idx: number) => ({
    nama: item.nama,
    kategoriLabel: item.kategori || "Destinasi",
    badgeClass: "badge-destinasi",
    rating: Math.min(5.0, 4.6 + ((score(item) * 4 + idx) % 5) * 0.08).toFixed(1),
    reviewCount: 100 + ((score(item) * 53 + idx * 11) % 1000),
    skor: score(item),
  })),
  ...jasa.map((item: any, idx: number) => ({
    nama: item.nama,
    kategoriLabel: item.jenisLayanan || item.kategori || "Jasa",
    badgeClass: "badge-jasa",
    rating: Math.min(5.0, 4.5 + ((score(item) * 3 + idx) % 5) * 0.08).toFixed(1),
    reviewCount: 30 + ((score(item) * 19 + idx * 7) % 300),
    skor: score(item),
  })),
];

// Urutkan berdasarkan skor kelengkapan, ambil top 10
const top10 = pool
  .filter((item) => item.nama && item.nama.trim() !== "")
  .sort((a, b) => b.skor - a.skor)
  .slice(0, 10);
---

<section class="mb-10">
  <div class="fade-in bg-surface rounded-card border border-border shadow-card p-6">
    <h2 class="text-[22px] font-bold text-primary mb-5">Top 10 UMKM</h2>

    <div class="w-full overflow-x-auto">
      <table class="w-full border-collapse text-left text-sm">
        <thead>
          <tr>
            <th class="px-4 py-3 text-[12px] font-bold text-text-secondary border-b-2 border-border uppercase tracking-[0.03em]">Rank</th>
            <th class="px-4 py-3 text-[12px] font-bold text-text-secondary border-b-2 border-border uppercase tracking-[0.03em]">Name</th>
            <th class="px-4 py-3 text-[12px] font-bold text-text-secondary border-b-2 border-border uppercase tracking-[0.03em]">Category</th>
            <th class="px-4 py-3 text-[12px] font-bold text-text-secondary border-b-2 border-border uppercase tracking-[0.03em]">Rating</th>
            <th class="px-4 py-3 text-[12px] font-bold text-text-secondary border-b-2 border-border uppercase tracking-[0.03em]">Reviews</th>
          </tr>
        </thead>
        <tbody>
          {
            top10.map((item, i) => (
              <tr class="border-b border-border-light last:border-0">
                <td class="px-4 py-3.5 align-middle font-extrabold text-primary text-[15px]">{i + 1}</td>
                <td class="px-4 py-3.5 align-middle font-bold text-text-primary">{item.nama}</td>
                <td class="px-4 py-3.5 align-middle">
                  <span class={`inline-block px-3 py-1 rounded-full text-[11px] font-extrabold tracking-[0.04em] ${badgeStyles[item.badgeClass] || 'bg-gray-100 text-gray-700'}`}>
                    {item.kategoriLabel}
                  </span>
                </td>
                <td class="px-4 py-3.5 align-middle font-bold">
                  <span class="text-star">★</span> {item.rating}
                </td>
                <td class="px-4 py-3.5 align-middle text-text-secondary">
                  {item.reviewCount.toLocaleString()}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
