---
/**
 * TeamCard.astro — Kartu Anggota Tim KKN
 * Desain: Avatar foto bulat besar, nama tebal, role berwarna teal, jurusan abu-abu.
 */
interface Props {
  name: string;
  role: string;
  major?: string;
  imageSrc?: string;
}

const {
  name,
  role,
  major = 'Informatika',
  imageSrc = 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=300&q=80'
} = Astro.props;
---

<div class="fade-in bg-surface rounded-card border border-border shadow-card px-4 py-7 flex flex-col items-center text-center transition-all duration-[250ms] hover:-translate-y-1 hover:shadow-hover">
  <!-- Avatar with gradient ring -->
  <div class="w-[100px] h-[100px] rounded-full p-[3px] mb-4 flex-shrink-0 shadow-[0_4px_14px_rgba(14,79,76,0.2)]"
    style="background: linear-gradient(135deg, #0E4F4C 0%, #0D9488 100%);">
    <img src={imageSrc} alt={name}
      class="w-full h-full rounded-full object-cover border-[3px] border-white" loading="lazy" />
  </div>
  <!-- Info -->
  <div class="flex flex-col items-center gap-0.5">
    <div class="text-[15px] font-bold text-text-primary leading-tight mb-0.5">{name}</div>
    <div class="text-[13px] font-semibold text-primary">{role}</div>
    <div class="text-[12px] font-medium text-text-secondary">{major}</div>
  </div>
</div>
