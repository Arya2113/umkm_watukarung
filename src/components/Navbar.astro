---
/**
 * Navbar.astro — Navigation Bar
 * Sesuai mockup referensi: Logo JELAJAH WATUKARUNG, menu Dashboard & About, serta tombol aksi kanan.
 */
const currentPath = Astro.url.pathname;
---

<nav
  class="sticky top-0 z-[1000] bg-white border-b border-border transition-shadow duration-[250ms]"
  id="navbar"
>
  <div class="max-w-container mx-auto px-5">
    <div class="flex items-center justify-between h-[72px]">
      <!-- Brand / Logo -->
      <a
        href="/"
        class="text-xl font-extrabold tracking-wide text-primary uppercase flex items-center gap-2 no-underline"
      >
        JELAJAH WATUKARUNG
      </a>

      <!-- Desktop Nav Links -->
      <ul class="hidden md:flex items-center gap-10 list-none ml-60 mr-auto">
        <li>
          <a
            href="/"
            class={`text-[15px] font-semibold py-6 relative transition-colors duration-150 ${currentPath === "/" ? "text-primary nav-link-active" : "text-text-secondary hover:text-primary"}`}
          >
            Dashboard
          </a>
        </li>
        <li>
          <a
            href="/tentang"
            class={`text-[15px] font-semibold py-6 relative transition-colors duration-150 ${currentPath === "/tentang" || currentPath.startsWith("/tentang") ? "text-primary nav-link-active" : "text-text-secondary hover:text-primary"}`}
          >
            About
          </a>
        </li>
      </ul>

      <!-- Right Actions -->
      <div class="flex items-center gap-3">
        <!-- Mobile menu toggle -->
        <button
          class="flex md:hidden items-center text-2xl text-text-primary"
          id="menu-toggle"
          aria-label="Toggle menu"
        >
          <i data-lucide="menu" id="icon-menu-open"></i>
          <i data-lucide="x" id="icon-menu-close" style="display:none;"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div
    class="hidden absolute top-[72px] left-0 right-0 bg-white border-b border-border px-5 py-4 shadow-[0_10px_25px_rgba(0,0,0,0.08)]"
    id="mobile-menu"
  >
    <a
      href="/"
      class={`block py-3 text-base font-semibold no-underline ${currentPath === "/" ? "text-primary" : "text-text-secondary"}`}
    >
      Dashboard
    </a>
    <a
      href="/tentang"
      class={`block py-3 text-base font-semibold no-underline ${currentPath.startsWith("/tentang") ? "text-primary" : "text-text-secondary"}`}
    >
      About
    </a>
  </div>
</nav>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const openIcon = document.getElementById("icon-menu-open");
  const closeIcon = document.getElementById("icon-menu-close");

  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const isOpen = menu.classList.toggle("hidden");
      // isOpen = true means it was just hidden (closed)
      if (openIcon) openIcon.style.display = isOpen ? "block" : "none";
      if (closeIcon) closeIcon.style.display = isOpen ? "none" : "block";
    });
  }

  const navbar = document.getElementById("navbar");
  if (navbar) {
    window.addEventListener("scroll", () => {
      navbar.classList.toggle("navbar-scrolled", window.scrollY > 10);
    });
  }
</script>
