---
/**
 * Footer.astro — Footer Halaman
 */
---

<footer class="bg-primary-dark text-white pt-12 pb-8 mt-16">
  <div class="max-w-container mx-auto px-5">
    <div class="flex flex-col gap-6 items-center text-center">
      <div class="flex items-center justify-center gap-3">
        <img src="/iconlogo.png" alt="Logo Watukarung Permai" class="w-12 h-12 object-contain" />
        <div class="text-xl font-extrabold tracking-wide">JELAJAH WATUKARUNG</div>
      </div>
      <p class="text-sm text-primary-light max-w-[500px]">
        Pusat Informasi Desa Wisata Watukarung, Pacitan, Jawa Timur — Hasil survei & pendataan potensi wisata dan UMKM desa oleh Tim KKN.
      </p>
      <div class="text-xs text-white/50 border-t border-white/10 w-full pt-6 mt-4">
        &copy; {new Date().getFullYear()} JELAJAH Watukarung. Hak Cipta Dilindungi.
      </div>
    </div>
  </div>
</footer>
